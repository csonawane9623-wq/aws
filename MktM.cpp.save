// ─────────────────────────────────────────────────────────────
//  Cross-platform gmtime
// ─────────────────────────────────────────────────────────────
#ifdef _WIN32
  #define GMTIME_SAFE(tm_ptr, t_ptr)  gmtime_s((tm_ptr), (t_ptr))
#else
  #define GMTIME_SAFE(tm_ptr, t_ptr)  gmtime_r((t_ptr), (tm_ptr))
#endif

