static const std::string API_KEY    = "Shlc2bqXOYOxN3dJpFDvhvperQIEz6";
static const std::string API_SECRET = "BSNFnU4afcyGMVjUs7i1jiStgdEndknRH1OsDcPdhhPVWcfDbaXMLqbqQhAf";
static const std::string BASE_URL   = "https://api.india.delta.exchange";
