static std::optional<json> get_position(long long product_id) {
    std::string path = "/v2/positions";
    std::string query = "?product_id=" + std::to_string(product_id);
    AuthHeaders a = auth_headers("GET", path, "", query);
    HttpResponse r = g_http.request("GET", BASE_URL + path + query, "", signed_headers(a));
    if (r.status == 429) {
        std::printf("[WARN] Rate limit hit on get_position. Sleeping 10s.\n");
        std::this_thread::sleep_for(std::chrono::seconds(10));
        return std::nullopt;
    }
    if (!r.ok) return std::nullopt;
    try {
        json j = json::parse(r.body);
        if (j.value("success", false)) {
            json res = j["result"];
            if (res.is_array()) {
                if (!res.empty()) return res[0];
                return std::nullopt;
            }
            return res;
        }
    } catch (...) {}
    return std::nullopt;
}

// Closes an open position. Retries once if the first close attempt results in
// a residual position (partial fill guard).
static bool close_position(long long product_id, const std::string &symbol) {
    for (int attempt = 1; attempt <= 2; ++attempt) {
        auto pos = get_position(product_id);
        if (!pos.has_value()) {
            std::printf("[WARN] No position found for %s (attempt %d)\n", symbol.c_str(), attempt);
            return false;
        }
        long long size = std::llabs(json_int(*pos, "size", 0));
        if (size == 0) {
            std::printf("[INFO] Position fully closed for %s\n", symbol.c_str());
            return true;
        }
        std::string close_side = (json_int(*pos, "size", 0) > 0) ? "sell" : "buy";
        auto result = place_market_order(product_id, close_side, size);
        if (result.has_value()) {
            std::printf("[CLOSE] %s | attempt=%d | side=%s | size=%lld | order_id=%s\n",
                        symbol.c_str(), attempt, close_side.c_str(), size,
                        result->contains("id") ? result->at("id").dump().c_str() : "N/A");
            std::this_thread::sleep_for(std::chrono::milliseconds(500));
        } else {
            std::printf("[ERROR] Close order failed for %s on attempt %d\n", symbol.c_str(), attempt);
            std::this_thread::sleep_for(std::chrono::seconds(1));
        }
    }

    auto pos = get_position(product_id);
    long long residual = pos.has_value() ? std::llabs(json_int(*pos, "size", 0)) : 0;
    if (residual > 0) {
        std::printf("[WARN] Residual position of %lld contracts remains for %s after 2 close attempts.\n",
                    residual, symbol.c_str());
        return false;
    }
    return true;
}

// =============================================================================
// CONTRACT SELECTION
// =============================================================================
struct RatedContract {
    double abs_rate;
    double rate;
    json contract;
};

static std::optional<RatedContract> select_best_contract() {
    auto contracts = get_all_perpetuals();
    if (contracts.empty()) {
        std::printf("[ERROR] No perpetual contracts fetched.\n");
        return std::nullopt;
    }

    std::vector<RatedContract> rated;
    for (auto &t : contracts) {
        try {
            double rate = json_num(t, "funding_rate", 0.0);
            double abs_rate = std::fabs(rate);
            if (abs_rate < MIN_FUNDING_RATE_ABS) continue;
            rated.push_back({abs_rate, rate, t});
        } catch (...) { continue; }
    }

    std::sort(rated.begin(), rated.end(),
              [](const RatedContract &a, const RatedContract &b) { return a.abs_rate > b.abs_rate; });

    separator();
    std::printf("  Threshold filter: |funding rate| >= %.4f%%\n", MIN_FUNDING_RATE_ABS);
    separator('-');

    if (rated.empty()) {
        std::printf("  No contracts meet the >= %.4f%% threshold. Skipping cycle.\n", MIN_FUNDING_RATE_ABS);
        separator();
        return std::nullopt;
    }

    std::printf("%-6s %-18s %15s  %-10s\n", "RANK", "SYMBOL", "FUNDING RATE", "DIRECTION");
    separator('-');
    for (size_t i = 0; i < std::min<size_t>(10, rated.size()); ++i) {
        std::string direction = rated[i].rate > 0 ? "SHORT" : "LONG";
        std::printf("%-6zu %-18s %+14.6f%%  %-10s\n", i + 1,
                    rated[i].contract.value("symbol", std::string("")).c_str(), rated[i].rate, direction.c_str());
    }
    separator();
    return rated[0];
}

// =============================================================================
// TRADE DETAIL DISPLAY
// =============================================================================
static void display_trade_details(
    const std::string &symbol, long long product_id, const std::string &side, long long size,
    double funding_rate, double mark_price, double contract_value, const std::string &contract_unit,
    double tick_size, double initial_margin, double maint_margin, double taker_fee, double maker_fee,
    double interval_h, long long next_funding_micro, long long entry_ts_s, long long close_ts_s,
    double balance, int leverage, std::optional<double> stop_price)
{
    double notional        = size * contract_value * mark_price;
    double margin_required = notional * (initial_margin / 100.0) / leverage;
    double est_funding_pnl = notional * (std::fabs(funding_rate) / 100.0);
    double est_taker_cost  = notional * taker_fee * 2.0;

    separator();
    std::printf("  TRADE CONFIGURATION & CONTRACT DETAILS\n");
    separator();
    std::printf("  %-35s %s\n", "Symbol", symbol.c_str());
    std::printf("  %-35s %lld\n", "Product ID", product_id);
    std::string side_upper = side; for (auto &c : side_upper) c = toupper(c);
    std::printf("  %-35s %s\n", "Direction", side_upper.c_str());
    std::printf("  %-35s Market Order\n", "Order Type");
    separator('-');
    std::printf("  %-35s %s\n", "Mark Price", format_price(mark_price, tick_size).c_str());
    std::printf("  %-35s %g %s\n", "Contract Value", contract_value, contract_unit.c_str());
    std::printf("  %-35s %g\n", "Tick Size", tick_size);
    std::printf("  %-35s %g%%\n", "Initial Margin", initial_margin);
    std::printf("  %-35s %g%%\n", "Maintenance Margin", maint_margin);
    std::printf("  %-35s %.4f%%\n", "Taker Fee", taker_fee * 100.0);
    std::printf("  %-35s %.4f%%\n", "Maker Fee", maker_fee * 100.0);
    separator('-');
    std::printf("  %-35s %+.6f%%\n", "Funding Rate", funding_rate);
    std::printf("  %-35s >= %.4f%% (absolute)\n", "Funding Rate Threshold", MIN_FUNDING_RATE_ABS);
    std::printf("  %-35s %.2f hour(s)\n", "Funding Interval", interval_h);
    std::printf("  %-35s %s\n", "Next Funding Time (IST)", fmt_ist(next_funding_micro / 1'000'000).c_str());
    separator('-');
    std::printf("  %-35s $%.2f\n", "Available Balance", balance);
    std::printf("  %-35s %dx\n", "Leverage", leverage);
    std::printf("  %-35s %lld\n", "Position Size (contracts)", size);
    std::printf("  %-35s $%.2f\n", "Notional Value", notional);
    std::printf("  %-35s $%.4f\n", "Margin Required (approx)", margin_required);
    std::printf("  %-35s $%.4f\n", "Est. Funding PnL (approx)", est_funding_pnl);
    std::printf("  %-35s $%.4f\n", "Est. Taker Fee Cost (approx)", est_taker_cost);
    if (stop_price.has_value()) {
        std::printf("  %-35s %s  (%.2f%% adverse move, min %d ticks)\n", "Stop Loss Trigger Price",
                    format_price(*stop_price, tick_size).c_str(), STOP_LOSS_PCT, MIN_STOP_TICKS);
    } else {
        std::printf("  %-35s DISABLED\n", "Stop Loss");
    }
    separator('-');
    std::printf("  %-35s %s\n", "Entry Time (IST)", fmt_ist(entry_ts_s).c_str());
    std::printf("  %-35s %s\n", "Funding Settlement (IST)", fmt_ist(next_funding_micro / 1'000'000).c_str());
    std::printf("  %-35s %s\n", "Close Time (IST)", fmt_ist(close_ts_s).c_str());
    separator();
}

// =============================================================================
// WAIT HELPER
// =============================================================================
static void wait_until_ts(double target_ts_s, const std::string &label) {
    while (true) {
        double diff = target_ts_s - now_epoch_d();
        if (diff <= 0) break;
        long long remaining_s = (long long)target_ts_s;
        std::printf("\r[WAIT] %s | Target: %s | Remaining: %.1fs   ",
                    label.c_str(), fmt_ist(remaining_s).c_str(), diff);
        std::fflush(stdout);
        std::this_thread::sleep_for(std::chrono::milliseconds(diff < 2.0 ? 200 : 1000));
    }
    std::printf("\n");
}

// =============================================================================
// MAIN LOOP
// =============================================================================
static std::atomic<bool> g_stop_requested{false};
static std::optional<long long> g_active_product_id;
static std::optional<long long> g_active_stop_order_id;
static std::mutex g_state_mutex;

static void signal_handler(int) { g_stop_requested = true; }

static void run_bot() {
    separator();
    std::printf("  DELTA EXCHANGE - FUNDING ARBITRAGE BOT  (FULLY AUTOMATIC) [C++]\n");
    std::printf("  Started at        : %s\n", fmt_ist(now_epoch_s()).c_str());
    std::printf("  Leverage          : %dx\n", LEVERAGE);
    std::printf("  Position          : %d%% of available balance\n", (int)(POSITION_PCT * 100));
    std::printf("  Min Funding Rate  : >= %.4f%% (absolute)\n", MIN_FUNDING_RATE_ABS);
    std::printf("  Entry             : %.0fs before funding settlement\n", ENTRY_BEFORE_S);
    std::printf("  Close             : %.0fms after funding settlement\n", CLOSE_AFTER_MS);
    std::printf("  Scan every        : %.0fs | Act only if funding <= %.0fs away\n", SCAN_INTERVAL_S, WINDOW_S);
    if (STOP_LOSS_ENABLED)
        std::printf("  Stop Loss         : ENABLED @ %.2f%% adverse move (min %d ticks)\n",
                    STOP_LOSS_PCT, MIN_STOP_TICKS);
    else
        std::printf("  Stop Loss         : DISABLED\n");
    separator();

    while (!g_stop_requested) {
        try {
            double loop_start = now_epoch_d();
            std::printf("\n[SCAN] %s - Scanning best perpetual contract...\n", fmt_ist(now_epoch_s()).c_str());

            // 1. Select best contract by highest absolute funding rate.
            auto best = select_best_contract();
            if (!best.has_value()) {
                double elapsed = now_epoch_d() - loop_start;
                double sleep_s = std::max(0.0, SCAN_INTERVAL_S - elapsed);
                std::printf("[WAIT] No qualifying contract found. Next scan in %.0fs.\n", sleep_s);
                std::this_thread::sleep_for(std::chrono::duration<double>(sleep_s));
                continue;
            }

            std::string symbol     = json_str(best->contract, "symbol", "");
            long long product_id   = json_int(best->contract, "product_id", 0);
            double rate            = best->rate;
            double mark_price      = json_num(best->contract, "mark_price", 0.0);
            std::string side       = (rate > 0) ? "sell" : "buy";

            // 2. Fetch product details for contract specs.
            auto product = get_product_details(symbol);
            if (!product.has_value()) {
                std::printf("[WARN] Could not fetch product details for %s. Skipping.\n", symbol.c_str());
                std::this_thread::sleep_for(std::chrono::seconds(60));
                continue;
            }

            double contract_value = json_num(*product, "contract_value", 1.0);
            std::string contract_unit = json_str(*product, "contract_unit_currency", "USD");
            double tick_size = json_num(*product, "tick_size", 0.5);
            double initial_margin = json_num(*product, "initial_margin", 1.0);
            double maint_margin   = json_num(*product, "maintenance_margin", 0.5);
            double taker_fee      = json_num(*product, "taker_commission_rate", 0.0005);
            double maker_fee      = json_num(*product, "maker_commission_rate", 0.0002);
            int interval_s = 3600;
            if (product->contains("product_specs") && (*product)["product_specs"].contains("rate_exchange_interval"))
                interval_s = (int)json_int((*product)["product_specs"], "rate_exchange_interval", 3600);
            double interval_h = interval_s / 3600.0;

            // 3. Get next funding time (WebSocket first, fallback to epoch-align).
            std::printf("[INFO] Fetching next funding time for %s via WebSocket...\n", symbol.c_str());
            auto next_funding_micro_opt = get_next_funding_time_ws(symbol);
            long long next_funding_micro;
            if (!next_funding_micro_opt.has_value()) {
                std::printf("[WARN] WebSocket timeout. Using epoch-aligned fallback.\n");
                next_funding_micro = get_next_funding_time_fallback(interval_s);
            } else {
                next_funding_micro = *next_funding_micro_opt;
            }

            double next_funding_s = next_funding_micro / 1'000'000.0;
            double secs_to_funding = next_funding_s - now_epoch_d();

            std::printf("[INFO] Next funding for %s: %s\n", symbol.c_str(),
                        fmt_ist(next_funding_micro / 1'000'000).c_str());
            std::printf("[INFO] Time to funding: %.1fs\n", secs_to_funding);

            // 4. Check if funding is within the action window.
            if (secs_to_funding > WINDOW_S) {
                std::printf("[SKIP] Funding is %.0fs away (> %.0fs window). Will re-scan in %.0fs.\n",
                            secs_to_funding, WINDOW_S, SCAN_INTERVAL_S);
                double elapsed = now_epoch_d() - loop_start;
                double sleep_s = std::max(0.0, SCAN_INTERVAL_S - elapsed);
                std::this_thread::sleep_for(std::chrono::duration<double>(sleep_s));
                continue;
            }
            if (secs_to_funding <= 0) {
                std::printf("[SKIP] Funding already passed. Re-scanning.\n");
                std::this_thread::sleep_for(std::chrono::seconds(10));
                continue;
            }

            // 5. Close any existing position from a previous cycle.
            if (g_active_product_id.has_value() && *g_active_product_id != product_id) {
                std::printf("[INFO] Closing previous position (product_id=%lld)\n", *g_active_product_id);
                if (g_active_stop_order_id.has_value()) {
                    cancel_order(*g_active_product_id, g_active_stop_order_id);
                    g_active_stop_order_id.reset();
                }
                close_position(*g_active_product_id, "previous_contract");
                g_active_product_id.reset();
            }

            // 6. Calculate position size.
            double balance = get_wallet_balance();
            if (balance <= 0) {
                std::printf("[ERROR] Could not fetch wallet balance or balance is zero.\n");
                std::this_thread::sleep_for(std::chrono::seconds(60));
                continue;
            }
            double raw_size = (balance * POSITION_PCT * LEVERAGE) / (contract_value * mark_price);
            long long size = std::max<long long>(1, (long long)raw_size);

            // 7. Calculate entry and close timestamps.
            double entry_ts_s = next_funding_s - ENTRY_BEFORE_S;
            double close_ts_s = next_funding_s + (CLOSE_AFTER_MS / 1000.0);

            // 8. Set leverage.
            if (set_leverage(product_id, LEVERAGE))
                std::printf("[INFO] Leverage set to %dx for %s\n", LEVERAGE, symbol.c_str());
            else
                std::printf("[WARN] Could not set leverage for %s. Proceeding anyway.\n", symbol.c_str());

            // 9. Wait until ENTRY_BEFORE_S seconds before funding, then re-verify live funding rate.
            wait_until_ts(entry_ts_s, "Waiting to enter " + symbol + " (" + side + ")");

            std::printf("\n[VERIFY] Re-checking live funding rate for %s before entry...\n", symbol.c_str());
            auto live_contracts = get_all_perpetuals();
            std::optional<double> live_rate;
            double live_price = mark_price;
            for (auto &c : live_contracts) {
                if (c.value("symbol", std::string("")) == symbol) {
                    live_rate  = json_num(c, "funding_rate", 0.0);
                    live_price = json_num(c, "mark_price", mark_price);
                    break;
                }
            }

            if (!live_rate.has_value()) {
                std::printf("[SKIP] Could not fetch live funding rate for %s. Aborting entry.\n", symbol.c_str());
                std::this_thread::sleep_for(std::chrono::seconds(10));
                continue;
            }
            if (std::fabs(*live_rate) < MIN_FUNDING_RATE_ABS) {
                std::printf("[SKIP] Live funding rate %+.6f%% is below threshold |%.4f%%|. Aborting entry.\n",
                            *live_rate, MIN_FUNDING_RATE_ABS);
                std::this_thread::sleep_for(std::chrono::seconds(10));
                continue;
            }

            side = (*live_rate > 0) ? "sell" : "buy";
            std::string side_upper = side; for (auto &c : side_upper) c = toupper(c);
            std::printf("[VERIFY] Live funding rate %+.6f%% meets threshold. Proceeding with %s entry.\n",
                        *live_rate, side_upper.c_str());

            // 9b. Compute stop-loss trigger price.
            std::optional<double> stop_price;
            std::string stop_side;
            if (STOP_LOSS_ENABLED) {
                stop_price = compute_stop_price(side, live_price, tick_size);
                if (stop_price.has_value()) stop_side = (side == "buy") ? "sell" : "buy";
            }

            // 9c. Display full trade configuration.
            display_trade_details(symbol, product_id, side, size, *live_rate, live_price, contract_value,
                                   contract_unit, tick_size, initial_margin, maint_margin, taker_fee, maker_fee,
                                   interval_h, next_funding_micro, (long long)entry_ts_s, (long long)close_ts_s,
                                   balance, LEVERAGE, stop_price);

            // 9d. Fire ENTRY and STOP-LOSS orders concurrently via threads.
            std::optional<json> entry_order, stop_order;
            std::printf("\n[ENTRY] Placing %s market order | %s | size=%lld\n", side_upper.c_str(),
                        symbol.c_str(), size);
            if (STOP_LOSS_ENABLED && stop_price.has_value()) {
                std::string stop_side_upper = stop_side; for (auto &c : stop_side_upper) c = toupper(c);
                std::printf("[STOP]  Simultaneously placing %s stop-loss | trigger=%s\n",
                            stop_side_upper.c_str(), format_price(*stop_price, tick_size).c_str());
            } else if (STOP_LOSS_ENABLED) {
                std::printf("[STOP]  Stop-loss skipped (could not compute valid stop price for this contract)\n");
            }

            std::thread t_entry([&]() { entry_order = place_market_order(product_id, side, size); });
            std::thread t_stop([&]() {
                if (STOP_LOSS_ENABLED && stop_price.has_value())
                    stop_order = place_stop_order(product_id, stop_side, size, *stop_price, tick_size);
            });
            t_entry.join();
            t_stop.join();

            if (!entry_order.has_value()) {
                std::printf("[ERROR] Entry order placement failed for %s.\n", symbol.c_str());
                if (stop_order.has_value()) {
                    std::printf("[CLEANUP] Entry failed but stop-loss order exists - cancelling it.\n");
                    cancel_order(product_id, json_int(*stop_order, "id", 0));
                }
                std::this_thread::sleep_for(std::chrono::seconds(10));
                continue;
            }

            std::printf("[ENTRY] Order placed successfully | order_id=%s | avg_fill=%s\n",
                        entry_order->contains("id") ? entry_order->at("id").dump().c_str() : "N/A",
                        entry_order->contains("average_fill_price")
                            ? entry_order->at("average_fill_price").dump().c_str() : "N/A");
            g_active_product_id = product_id;

            // 9e. Reconcile stop-loss size against actual filled size.
            long long requested_size = size;
            long long unfilled = json_int(*entry_order, "unfilled_size", 0);
            long long filled_size = requested_size - unfilled;

            if (STOP_LOSS_ENABLED && stop_price.has_value()) {
                if (filled_size <= 0) {
                    std::printf("[WARN] Entry order filled 0 contracts. Cancelling stop-loss if placed.\n");
                    if (stop_order.has_value()) cancel_order(product_id, json_int(*stop_order, "id", 0));
                    g_active_product_id.reset();
                    g_active_stop_order_id.reset();
                    std::this_thread::sleep_for(std::chrono::seconds(10));
                    continue;
                }
                if (filled_size != requested_size) {
                    std::printf("[WARN] Partial fill: requested=%lld, filled=%lld. Re-placing stop-loss with correct size.\n",
                                requested_size, filled_size);
                    if (stop_order.has_value()) cancel_order(product_id, json_int(*stop_order, "id", 0));
                    stop_order = place_stop_order(product_id, stop_side, filled_size, *stop_price, tick_size);
                }
                if (stop_order.has_value()) {
                    g_active_stop_order_id = json_int(*stop_order, "id", 0);
                    std::string stop_side_upper = stop_side; for (auto &c : stop_side_upper) c = toupper(c);
                    std::printf("[STOP]  Stop-loss confirmed | order_id=%lld | trigger=%s | side=%s | size=%lld\n",
                                *g_active_stop_order_id, format_price(*stop_price, tick_size).c_str(),
                                stop_side_upper.c_str(), filled_size);
                } else {
                    g_active_stop_order_id.reset();
                    std::printf("[WARN]  Stop-loss order FAILED to place - position is currently unprotected!\n");
                }
            }

            // 10. Wait until CLOSE_AFTER_MS after funding, then close.
            wait_until_ts(close_ts_s, "Waiting to close after funding settlement");

            if (g_active_stop_order_id.has_value()) {
                std::printf("[CLEANUP] Cancelling resting stop-loss order_id=%lld before scheduled close.\n",
                            *g_active_stop_order_id);
                cancel_order(product_id, g_active_stop_order_id);
                g_active_stop_order_id.reset();
            }

            std::printf("\n[CLOSE] Closing position for %s...\n", symbol.c_str());
            close_position(product_id, symbol);
            g_active_product_id.reset();

            // 11. Sleep until next scan cycle.
            double elapsed = now_epoch_d() - loop_start;
            double sleep_s = std::max(0.0, SCAN_INTERVAL_S - elapsed);
            std::printf("\n[CYCLE] Trade cycle complete. Next scan in %.0fs.\n", sleep_s);
            separator();
            std::this_thread::sleep_for(std::chrono::duration<double>(sleep_s));

        } catch (const std::exception &e) {
            std::printf("[ERROR] Unexpected error in main loop: %s\n", e.what());
            if (g_active_product_id.has_value())
                std::printf("[WARN] Open position may exist for product_id=%lld. Will attempt cleanup on next iteration.\n",
                            *g_active_product_id);
            std::this_thread::sleep_for(std::chrono::seconds(30));
        }
    }

    // Ctrl+C / termination cleanup, mirroring the Python KeyboardInterrupt handler.
    std::printf("\n[STOP] Bot stopped by user.\n");
    if (g_active_stop_order_id.has_value()) {
        std::printf("[STOP] Cancelling resting stop-loss order_id=%lld...\n", *g_active_stop_order_id);
        cancel_order(g_active_product_id.value_or(0), g_active_stop_order_id);
    }
    if (g_active_product_id.has_value()) {
        std::printf("[STOP] Attempting to close open position (product_id=%lld)...\n", *g_active_product_id);
        close_position(*g_active_product_id, "open_position");
    }
}

int main() {
    socket_platform_init();

    load_dotenv();
    API_KEY    = env_or("API_KEY");
    API_SECRET = env_or("API_SECRET");

    std::signal(SIGINT, signal_handler);
    std::signal(SIGTERM, signal_handler);

    run_bot();

    socket_platform_cleanup();
    return 0;
}
