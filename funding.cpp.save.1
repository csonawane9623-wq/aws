using json = nlohmann::json;
using Clock = std::chrono::system_clock;

// Delta Exchange's REST API is inconsistent about whether numeric fields are
// sent as JSON numbers or as numeric strings (e.g. "size" is often a number,
// "available_balance" is often a string, and it can vary by endpoint). Using
// plain `.value<std::string>()` or `.value<long long>()` throws a
// nlohmann::json type_error the moment the type doesn't match. These helpers
// accept either representation.
static double json_num(const json &j, const std::string &key, double def) {
    if (!j.contains(key) || j[key].is_null()) return def;
    const json &v = j[key];
    if (v.is_number()) return v.get<double>();
    if (v.is_string()) {
        try { return std::stod(v.get<std::string>()); } catch (...) { return def; }
    }
    return def;
}

static long long json_int(const json &j, const std::string &key, long long def) {
    if (!j.contains(key) || j[key].is_null()) return def;
    const json &v = j[key];
    if (v.is_number_integer() || v.is_number_unsigned()) return v.get<long long>();
    if (v.is_number()) return (long long)v.get<double>();
    if (v.is_string()) {
        try { return std::stoll(v.get<std::string>()); } catch (...) { return def; }
    }
    return def;
}

static std::string json_str(const json &j, const std::string &key, const std::string &def = "") {
    if (!j.contains(key) || j[key].is_null()) return def;
    const json &v = j[key];
    if (v.is_string()) return v.get<std::string>();
    return v.dump(); // numbers/bools rendered as their literal text
}

