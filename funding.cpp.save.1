// =============================================================================
// DELTA EXCHANGE INDIA - FUNDING RATE ARBITRAGE BOT (C++ PORT)
//
// Ported from a Python reference implementation. Behavior, thresholds and
// control flow intentionally mirror the original as closely as C++ allows.
//
// Dependencies (Ubuntu/Debian):
//   sudo apt install libcurl4-openssl-dev libssl-dev nlohmann-json3-dev
//
// Dependencies (MSYS2 UCRT64):
//   pacman -S mingw-w64-ucrt-x86_64-curl mingw-w64-ucrt-x86_64-openssl \
//             mingw-w64-ucrt-x86_64-nlohmann-json mingw-w64-ucrt-x86_64-gcc
//
// Build (Linux):
//   g++ -std=c++17 -O2 funding_arb_bot.cpp -o funding_arb_bot \
//       -lcurl -lssl -lcrypto -lpthread
//
// Build (MSYS2 UCRT64):
//   g++ -std=c++17 -O2 funding_arb_bot.cpp -o funding_arb_bot.exe \
//       -lcurl -lssl -lcrypto -lpthread -lws2_32
//
// Environment variables (create a .env file next to the binary, or export):
//   API_KEY=...
//   API_SECRET=...
//
// NOTE ON THE WEBSOCKET CLIENT
// -----------------------------------------------------------------------------
// Rather than pull in a heavyweight websocket dependency (libwebsockets,
// IXWebSocket, etc.) which is often awkward to get consistently working
// across Ubuntu/MSYS2 toolchains, this port implements a minimal RFC6455
// client directly on top of OpenSSL (TLS) + BSD sockets. It supports exactly
// what this bot needs: connect -> TLS handshake -> HTTP upgrade -> send one
// text frame -> read text frames with a timeout -> close. This keeps the
// dependency surface identical to your other C++ bots (curl + openssl only).
// =============================================================================

// ---- Cross-platform socket layer ------------------------------------------
// MSYS2/MinGW (Windows) has no POSIX socket headers (arpa/inet.h, unistd.h
// sockets, fcntl on sockets, etc.) - it uses Winsock2 instead. This block
// gives us one small compatibility shim so the rest of the file can use
// plain BSD-style calls (socket/connect/select/close) on both platforms.
#if defined(_WIN32)
    #ifndef WIN32_LEAN_AND_MEAN
        #define WIN32_LEAN_AND_MEAN
    #endif
    #include <winsock2.h>
    #include <ws2tcpip.h>
    #pragma comment(lib, "ws2_32.lib")
    using socket_t = SOCKET;
    static constexpr socket_t INVALID_SOCK = INVALID_SOCKET;
    static inline int close_socket(socket_t s) { return closesocket(s); }
    static inline void set_nonblocking(socket_t s, bool nonblocking) {
        u_long mode = nonblocking ? 1 : 0;
        ioctlsocket(s, FIONBIO, &mode);
    }
    static inline bool would_block_or_in_progress() {
        int e = WSAGetLastError();
        return e == WSAEWOULDBLOCK || e == WSAEINPROGRESS;
    }
    static inline void socket_platform_init() {
        WSADATA wsa;
        WSAStartup(MAKEWORD(2, 2), &wsa);
    }
    static inline void socket_platform_cleanup() { WSACleanup(); }
#else
    #include <arpa/inet.h>
    #include <netdb.h>
    #include <sys/select.h>
    #include <sys/socket.h>
    #include <unistd.h>
    #include <fcntl.h>
    #include <errno.h>
    using socket_t = int;
    static constexpr socket_t INVALID_SOCK = -1;
    static inline int close_socket(socket_t s) { return ::close(s); }
    static inline void set_nonblocking(socket_t s, bool nonblocking) {
        int flags = fcntl(s, F_GETFL, 0);
        if (nonblocking) fcntl(s, F_SETFL, flags | O_NONBLOCK);
        else fcntl(s, F_SETFL, flags & ~O_NONBLOCK);
    }
    static inline bool would_block_or_in_progress() {
        return errno == EWOULDBLOCK || errno == EINPROGRESS || errno == EAGAIN;
    }
    static inline void socket_platform_init() {}
    static inline void socket_platform_cleanup() {}
#endif
// -----------------------------------------------------------------------------

