static std::vector<json> get_all_perpetuals() {
    std::string url = BASE_URL + "/v2/tickers?contract_types=perpetual_futures";
    HttpResponse r = g_http.request("GET", url, "", base_headers());
    if (r.status == 429) {
        std::printf("[WARN] Rate limit hit on get_all_perpetuals. Sleeping 10s.\n");
        std::this_thread::sleep_for(std::chrono::seconds(10));
        return {};
    }
    if (!r.ok) return {};
    try {
        json j = json::parse(r.body);
        if (j.value("success", false))
            return j["result"].get<std::vector<json>>();
    } catch (...) {}
    return {};
}

static std::optional<json> get_product_details(const std::string &symbol) {
    std::string url = BASE_URL + "/v2/products/" + symbol;
    HttpResponse r = g_http.request("GET", url, "", base_headers());
    if (r.status == 429) {
        std::printf("[WARN] Rate limit hit on get_product_details. Sleeping 10s.\n");
        std::this_thread::sleep_for(std::chrono::seconds(10));
        return std::nullopt;
    }
    if (!r.ok) return std::nullopt;
    try {
        json j = json::parse(r.body);
        if (j.value("success", false)) return j["result"];
    } catch (...) {}
    return std::nullopt;
}

static double get_wallet_balance() {
    std::string path = "/v2/wallet/balances";
    AuthHeaders a = auth_headers("GET", path);
    HttpResponse r = g_http.request("GET", BASE_URL + path, "", signed_headers(a));
    if (r.status == 429) {
        std::printf("[WARN] Rate limit hit on get_wallet_balance. Sleeping 10s.\n");
        std::this_thread::sleep_for(std::chrono::seconds(10));
        return 0.0;
    }
    if (!r.ok) return 0.0;
    try {
        json j = json::parse(r.body);
        if (j.value("success", false)) {
            std::vector<std::string> symbols;
            for (auto &b : j["result"]) {
                std::string sym = json_str(b, "asset_symbol", "");
                symbols.push_back(sym);
                if (sym == "USD") return json_num(b, "available_balance", 0.0);
            }
            std::string joined;
            for (auto &s : symbols) joined += s + " ";
            std::printf("[WARN] 'USD' not found in wallet. Available asset symbols: %s\n", joined.c_str());
        } else {
            std::printf("[ERROR] get_wallet_balance API error: %s\n", r.body.substr(0, 300).c_str());
        }
    } catch (const std::exception &e) {
        std::printf("[ERROR] get_wallet_balance parse error: %s\n", e.what());
    }
    return 0.0;
}

