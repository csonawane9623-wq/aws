// =============================================================================
// SMALL UTILITIES
// =============================================================================
static void separator(char ch = '=', int width = 110) {
    std::cout << std::string(width, ch) << "\n";
}

static void load_dotenv(const std::string &path = ".env") {
    std::ifstream f(path);
    if (!f.is_open()) return;
    std::string line;
    while (std::getline(f, line)) {
        if (line.empty() || line[0] == '#') continue;
        auto eq = line.find('=');
        if (eq == std::string::npos) continue;
        std::string key = line.substr(0, eq);
        std::string val = line.substr(eq + 1);
        // trim whitespace/CR
        auto trim = [](std::string &s) {
            while (!s.empty() && (s.back() == '\r' || s.back() == '\n' || s.back() == ' '))
                s.pop_back();
        };
        trim(key);
        trim(val);
        if (!val.empty() && val.front() == '"' && val.back() == '"')
            val = val.substr(1, val.size() - 2);
        // Don't override a real environment variable that's already set.
        if (std::getenv(key.c_str()) != nullptr) continue;
#if defined(_WIN32)
        _putenv_s(key.c_str(), val.c_str());
#else
        setenv(key.c_str(), val.c_str(), 0);
#endif
    }
}

static std::string env_or(const char *name, const std::string &fallback = "") {
    const char *v = std::getenv(name);
    return v ? std::string(v) : fallback;
}

// time_t (UTC seconds) -> "YYYY-MM-DD HH:MM:SS IST"
static std::string fmt_ist(long long epoch_seconds_utc) {
    time_t t = (time_t)(epoch_seconds_utc + IST_OFFSET_SECONDS);
    std::tm tmv{};
#if defined(_WIN32)
    gmtime_s(&tmv, &t); // note: argument order is reversed vs. POSIX gmtime_r
#else
    gmtime_r(&t, &tmv);
#endif
    char buf[64];
    std::snprintf(buf, sizeof(buf), "%04d-%02d-%02d %02d:%02d:%02d IST",
                  tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday,
                  tmv.tm_hour, tmv.tm_min, tmv.tm_sec);
    return std::string(buf);
}

static long long now_epoch_s() {
    return (long long)std::time(nullptr);
}

static double now_epoch_d() {
    return std::chrono::duration<double>(Clock::now().time_since_epoch()).count();
}

// =============================================================================
// AUTHENTICATION (HMAC-SHA256, hex digest, via OpenSSL)
// =============================================================================
static std::string hmac_sha256_hex(const std::string &secret, const std::string &message) {
    unsigned char digest[EVP_MAX_MD_SIZE];
    unsigned int digest_len = 0;
    HMAC(EVP_sha256(),
         secret.data(), (int)secret.size(),
         reinterpret_cast<const unsigned char *>(message.data()), message.size(),
         digest, &digest_len);

    std::ostringstream oss;
    oss << std::hex << std::setfill('0');
    for (unsigned int i = 0; i < digest_len; ++i)
        oss << std::setw(2) << (int)digest[i];
    return oss.str();
}

struct AuthHeaders {
    std::string api_key;
    std::string timestamp;
    std::string signature;
};

static AuthHeaders auth_headers(const std::string &method, const std::string &path,
                                 const std::string &payload = "", const std::string &query = "") {
    AuthHeaders h;
    h.timestamp = std::to_string(now_epoch_s());
    std::string message = method + h.timestamp + path + query + payload;
    h.signature = hmac_sha256_hex(API_SECRET, message);
    h.api_key   = API_KEY;
    return h;
}

// =============================================================================
// TICK SIZE UTILITIES
// Handles very small prices like 1000SATSUSD (0.000001 tick size)
// =============================================================================
static int tick_decimals(double tick_size) {
    if (tick_size >= 1.0) return 0;
    int decimals = (int)(-std::floor(std::log10(tick_size)));
    return std::max(0, decimals);
}

static double round_to_tick(double price, double tick_size) {
    int decimals = tick_decimals(tick_size);
    double rounded = std::round(price / tick_size) * tick_size;
    double mult = std::pow(10.0, decimals);
    return std::round(rounded * mult) / mult;
}

static std::string format_price(double price, double tick_size) {
    int decimals = tick_decimals(tick_size);
    std::ostringstream oss;
    oss << std::fixed << std::setprecision(decimals) << price;
    return oss.str();
}

// =============================================================================
// STOP PRICE CALCULATION
// For a SHORT (sell) entry -> stop is a BUY  -> price must be ABOVE market
// For a LONG  (buy)  entry -> stop is a SELL -> price must be BELOW market
// =============================================================================
static std::optional<double> compute_stop_price(const std::string &side, double live_price,
                                                  double tick_size) {
    double raw_stop;
    if (side == "buy")
        raw_stop = live_price * (1.0 - STOP_LOSS_PCT / 100.0);
    else
        raw_stop = live_price * (1.0 + STOP_LOSS_PCT / 100.0);

    double stop_price = round_to_tick(raw_stop, tick_size);

    if (stop_price <= 0.0) {
        std::printf("[WARN] Computed stop price is zero or negative (raw=%.10f, tick=%g). "
                    "Stop-loss disabled for this trade.\n", raw_stop, tick_size);
        return std::nullopt;
    }

    double min_distance = MIN_STOP_TICKS * tick_size;
    if (side == "buy") {
        // SELL stop must be below market by at least MIN_STOP_TICKS
        if (live_price - stop_price < min_distance) {
            stop_price = round_to_tick(live_price - min_distance, tick_size);
            std::printf("[INFO] Stop price adjusted to maintain minimum %d-tick distance: %s\n",
                        MIN_STOP_TICKS, format_price(stop_price, tick_size).c_str());
        }
    } else {
        // BUY stop must be above market by at least MIN_STOP_TICKS
        if (stop_price - live_price < min_distance) {
            stop_price = round_to_tick(live_price + min_distance, tick_size);
            std::printf("[INFO] Stop price adjusted to maintain minimum %d-tick distance: %s\n",
                        MIN_STOP_TICKS, format_price(stop_price, tick_size).c_str());
        }
    }

    if (stop_price <= 0.0) {
        std::printf("[WARN] Stop price still invalid after adjustment. Stop-loss disabled for this trade.\n");
        return std::nullopt;
    }
    return stop_price;
}

// =============================================================================
// MINIMAL RFC6455 WEBSOCKET CLIENT (TLS via OpenSSL)
// Only implements what this bot needs: connect, upgrade, send one text frame,
// read text frames with a timeout, close.
// =============================================================================
class MiniWebSocket {
public:
    ~MiniWebSocket() { close(); }

    bool connect(const std::string &host, int port, int connect_timeout_s = 8) {
        struct addrinfo hints{}, *res = nullptr;
        hints.ai_family   = AF_UNSPEC;
        hints.ai_socktype = SOCK_STREAM;
        std::string port_str = std::to_string(port);
        if (getaddrinfo(host.c_str(), port_str.c_str(), &hints, &res) != 0 || !res)
            return false;

        fd_ = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
        if (fd_ == INVALID_SOCK) { freeaddrinfo(res); return false; }

        // Non-blocking connect with timeout.
        set_nonblocking(fd_, true);

        int rc = ::connect(fd_, res->ai_addr, (int)res->ai_addrlen);
        freeaddrinfo(res);
        if (rc != 0 && !would_block_or_in_progress()) { close(); return false; }

        fd_set wfds;
        FD_ZERO(&wfds);
        FD_SET(fd_, &wfds);
        timeval tv{connect_timeout_s, 0};
        rc = select((int)fd_ + 1, nullptr, &wfds, nullptr, &tv);
        if (rc <= 0) { close(); return false; }

        int so_error = 0;
        socklen_t len = sizeof(so_error);
        getsockopt(fd_, SOL_SOCKET, SO_ERROR, (char *)&so_error, &len);
        if (so_error != 0) { close(); return false; }

        set_nonblocking(fd_, false); // back to blocking for the TLS handshake

        ctx_ = SSL_CTX_new(TLS_client_method());
        if (!ctx_) { close(); return false; }
        SSL_CTX_set_default_verify_paths(ctx_);
        SSL_CTX_set_verify(ctx_, SSL_VERIFY_PEER, nullptr);

        ssl_ = SSL_new(ctx_);
        SSL_set_fd(ssl_, (int)fd_);
        SSL_set_tlsext_host_name(ssl_, host.c_str());
        SSL_set1_host(ssl_, host.c_str());

        if (SSL_connect(ssl_) != 1) { close(); return false; }

        // Back to non-blocking for the frame read loop.
        set_nonblocking(fd_, true);
        return true;
    }

    bool handshake(const std::string &host, const std::string &path) {
        unsigned char key_raw[16];
        RAND_bytes(key_raw, sizeof(key_raw));
        std::string sec_key = base64_encode(key_raw, sizeof(key_raw));

        std::ostringstream req;
        req << "GET " << path << " HTTP/1.1\r\n"
            << "Host: " << host << "\r\n"
            << "Upgrade: websocket\r\n"
            << "Connection: Upgrade\r\n"
            << "Sec-WebSocket-Key: " << sec_key << "\r\n"
            << "Sec-WebSocket-Version: 13\r\n"
            << "\r\n";
        std::string req_s = req.str();
        if (!ssl_write_all(req_s)) return false;

        std::string resp;
        auto deadline = Clock::now() + std::chrono::seconds(8);
        while (resp.find("\r\n\r\n") == std::string::npos) {
            if (Clock::now() > deadline) return false;
            char buf[2048];
            int n = poll_and_read(buf, sizeof(buf), 200);
            if (n > 0) resp.append(buf, n);
            else if (n < 0) return false;
        }
        return resp.find("101") != std::string::npos; // "HTTP/1.1 101 Switching Protocols"
    }

    bool send_text(const std::string &payload) {
        std::string frame;
        frame.push_back((char)0x81); // FIN + text opcode

        unsigned char mask_key[4];
        RAND_bytes(mask_key, sizeof(mask_key));

        size_t len = payload.size();
        if (len <= 125) {
            frame.push_back((char)(0x80 | len));
        } else if (len <= 65535) {
            frame.push_back((char)(0x80 | 126));
            frame.push_back((char)((len >> 8) & 0xFF));
            frame.push_back((char)(len & 0xFF));
        } else {
            frame.push_back((char)(0x80 | 127));
            for (int i = 7; i >= 0; --i)
                frame.push_back((char)((len >> (8 * i)) & 0xFF));
        }
        frame.append(reinterpret_cast<const char *>(mask_key), 4);
        for (size_t i = 0; i < len; ++i)
            frame.push_back((char)(payload[i] ^ mask_key[i % 4]));

        return ssl_write_all(frame);
    }

    // Reads one WS text-frame payload within timeout_ms. Returns false on
    // timeout/error, true with `out` populated on success. Auto-replies to pings.
    bool recv_text(std::string &out, int timeout_ms) {
        auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
        while (Clock::now() < deadline) {
            int remaining_ms = (int)std::chrono::duration_cast<std::chrono::milliseconds>(
                                    deadline - Clock::now()).count();
            if (remaining_ms <= 0) break;

            if (!read_frame_header(std::min(remaining_ms, 500))) continue;

            uint8_t opcode = header_byte0_ & 0x0F;
            uint64_t plen = payload_len_;
            std::string payload;
            payload.resize(plen);
            size_t got = 0;
            while (got < plen) {
                int chunk_deadline_ms = (int)std::chrono::duration_cast<std::chrono::milliseconds>(
                                             deadline - Clock::now()).count();
                if (chunk_deadline_ms <= 0) return false;
                int n = poll_and_read(&payload[got], plen - got, std::min(chunk_deadline_ms, 500));
                if (n > 0) got += n;
                else if (n < 0) return false;
            }

            if (opcode == 0x1) { // text frame
                out = payload;
                return true;
            } else if (opcode == 0x9) { // ping -> pong
                send_pong(payload);
            } else if (opcode == 0x8) { // close
                return false;
            }
            // ignore other control/continuation frames for this simple use case
        }
        return false;
    }

    void close() {
        if (ssl_) { SSL_shutdown(ssl_); SSL_free(ssl_); ssl_ = nullptr; }
        if (ctx_) { SSL_CTX_free(ctx_); ctx_ = nullptr; }
        if (fd_ != INVALID_SOCK) { close_socket(fd_); fd_ = INVALID_SOCK; }
    }

private:
    socket_t fd_ = INVALID_SOCK;
    SSL_CTX *ctx_ = nullptr;
    SSL *ssl_ = nullptr;
    uint8_t header_byte0_ = 0;
    uint64_t payload_len_ = 0;

    bool ssl_write_all(const std::string &data) {
        size_t sent = 0;
        while (sent < data.size()) {
            int n = SSL_write(ssl_, data.data() + sent, (int)(data.size() - sent));
            if (n <= 0) {
                int err = SSL_get_error(ssl_, n);
                if (err == SSL_ERROR_WANT_WRITE || err == SSL_ERROR_WANT_READ) continue;
                return false;
            }
            sent += n;
        }
        return true;
    }

    // Returns bytes read (>0), 0 on timeout, -1 on error.
    int poll_and_read(void *buf, size_t maxlen, int timeout_ms) {
        fd_set rfds;
        FD_ZERO(&rfds);
        FD_SET(fd_, &rfds);
        timeval tv{timeout_ms / 1000, (timeout_ms % 1000) * 1000};
        int rc = select((int)fd_ + 1, &rfds, nullptr, nullptr, &tv);
        if (rc == 0) return 0;
        if (rc < 0) return -1;

        int n = SSL_read(ssl_, buf, (int)maxlen);
        if (n > 0) return n;
        int err = SSL_get_error(ssl_, n);
        if (err == SSL_ERROR_WANT_READ || err == SSL_ERROR_WANT_WRITE) return 0;
        return -1;
    }

    bool read_frame_header(int timeout_ms) {
        unsigned char b0b1[2];
        size_t got = 0;
        auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
        while (got < 2) {
            if (Clock::now() > deadline) return false;
            int n = poll_and_read(reinterpret_cast<char *>(b0b1) + got, 2 - got, 200);
            if (n > 0) got += n;
            else if (n < 0) return false;
        }
        header_byte0_ = b0b1[0];
        uint8_t len7 = b0b1[1] & 0x7F; // server frames are unmasked
        if (len7 <= 125) {
            payload_len_ = len7;
        } else if (len7 == 126) {
            unsigned char ext[2];
            if (!read_exact(ext, 2, timeout_ms)) return false;
            payload_len_ = (uint64_t(ext[0]) << 8) | ext[1];
        } else {
            unsigned char ext[8];
            if (!read_exact(ext, 8, timeout_ms)) return false;
            payload_len_ = 0;
            for (int i = 0; i < 8; ++i) payload_len_ = (payload_len_ << 8) | ext[i];
        }
        return true;
    }

    bool read_exact(unsigned char *buf, size_t n, int timeout_ms) {
        size_t got = 0;
        auto deadline = Clock::now() + std::chrono::milliseconds(timeout_ms);
        while (got < n) {
            if (Clock::now() > deadline) return false;
            int r = poll_and_read(buf + got, n - got, 200);
            if (r > 0) got += r;
            else if (r < 0) return false;
        }
        return true;
    }

    void send_pong(const std::string &payload) {
        std::string frame;
        frame.push_back((char)0x8A); // FIN + pong opcode
        unsigned char mask_key[4];
        RAND_bytes(mask_key, sizeof(mask_key));
        frame.push_back((char)(0x80 | payload.size()));
        frame.append(reinterpret_cast<const char *>(mask_key), 4);
        for (size_t i = 0; i < payload.size(); ++i)
            frame.push_back((char)(payload[i] ^ mask_key[i % 4]));
        ssl_write_all(frame);
    }

    static std::string base64_encode(const unsigned char *data, size_t len) {
        std::string out;
        out.resize(4 * ((len + 2) / 3));
        int n = EVP_EncodeBlock(reinterpret_cast<unsigned char *>(&out[0]), data, (int)len);
        out.resize(n);
        return out;
    }
};

// Subscribes to the funding_rate WS channel for `symbol` and returns
// next_funding_realization in microseconds (UTC epoch), or nullopt on timeout.
static std::optional<long long> get_next_funding_time_ws(const std::string &symbol, int timeout_s = 8) {
    MiniWebSocket ws;
    if (!ws.connect(WS_HOST, WS_PORT, timeout_s)) return std::nullopt;
    if (!ws.handshake(WS_HOST, "/")) return std::nullopt;

    json sub = {
        {"type", "subscribe"},
        {"payload", {
            {"channels", json::array({
                {{"name", "funding_rate"}, {"symbols", json::array({symbol})}}
            })}
        }}
    };
    if (!ws.send_text(sub.dump())) return std::nullopt;

    auto deadline = Clock::now() + std::chrono::seconds(timeout_s);
    while (Clock::now() < deadline) {
        int remaining_ms = (int)std::chrono::duration_cast<std::chrono::milliseconds>(
                                deadline - Clock::now()).count();
        if (remaining_ms <= 0) break;
        std::string msg;
        if (!ws.recv_text(msg, remaining_ms)) continue;
        try {
            json data = json::parse(msg);
            if (data.value("type", "") == "funding_rate" && data.contains("nfr")) {
                // nfr may arrive as a number or a numeric string depending on payload
                if (data["nfr"].is_number())
                    return data["nfr"].get<long long>();
                else
                    return std::stoll(data["nfr"].get<std::string>());
            }
        } catch (...) {
            // ignore malformed/irrelevant messages
        }
    }
    return std::nullopt;
}

// Epoch-aligned next funding time fallback (e.g. interval=3600 -> next top-of-hour UTC).
static long long get_next_funding_time_fallback(int interval_s) {
    long long now_s = now_epoch_s();
    long long next_s = ((now_s / interval_s) + 1) * (long long)interval_s;
    return next_s * 1'000'000LL;
}

// =============================================================================
// HTTP (libcurl) LAYER
// =============================================================================
struct HttpResponse {
    long status = 0;
    std::string body;
    bool ok = false; // transport-level success (curl call itself didn't error)
};

static size_t curl_write_cb(char *ptr, size_t size, size_t nmemb, void *userdata) {
    auto *out = static_cast<std::string *>(userdata);
    out->append(ptr, size * nmemb);
    return size * nmemb;
}

class HttpClient {
public:
    HttpClient() { curl_global_init(CURL_GLOBAL_DEFAULT); }
    ~HttpClient() { curl_global_cleanup(); }

    HttpResponse request(const std::string &method, const std::string &url,
                          const std::string &body, const std::vector<std::string> &headers) {
        HttpResponse resp;
        CURL *curl = curl_easy_init();
        if (!curl) return resp;

        struct curl_slist *hdrs = nullptr;
        for (auto &h : headers) hdrs = curl_slist_append(hdrs, h.c_str());

        curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
        curl_easy_setopt(curl, CURLOPT_HTTPHEADER, hdrs);
        curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, curl_write_cb);
        curl_easy_setopt(curl, CURLOPT_WRITEDATA, &resp.body);
        curl_easy_setopt(curl, CURLOPT_TIMEOUT, 10L);
        curl_easy_setopt(curl, CURLOPT_USERAGENT, "rest-client");

        if (method == "GET") {
            curl_easy_setopt(curl, CURLOPT_HTTPGET, 1L);
        } else if (method == "POST") {
            curl_easy_setopt(curl, CURLOPT_POST, 1L);
            curl_easy_setopt(curl, CURLOPT_POSTFIELDS, body.c_str());
            curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE, (long)body.size());
        } else if (method == "DELETE") {
            curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, "DELETE");
            curl_easy_setopt(curl, CURLOPT_POSTFIELDS, body.c_str());
            curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE, (long)body.size());
        }

        CURLcode rc = curl_easy_perform(curl);
        if (rc == CURLE_OK) {
            resp.ok = true;
            curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &resp.status);
        }
        curl_slist_free_all(hdrs);
        curl_easy_cleanup(curl);
        return resp;
    }
};

static HttpClient g_http;

static std::vector<std::string> base_headers() {
    return {"Content-Type: application/json"};
}

static std::vector<std::string> signed_headers(const AuthHeaders &a) {
    return {
        "api-key: " + a.api_key,
        "timestamp: " + a.timestamp,
        "signature: " + a.signature,
        "Content-Type: application/json",
        "User-Agent: rest-client",
    };
}

